# exsim example configuration. Format: docs in include/exsim/server/con2ig.hpp.

[exchange]
name = EXSIM                 # FIX Tar
fix_port = 15001             # FIX 4.4
admin_port = 15002           # line-based admin / fault-injection console
max_connections = 64
heartbeat_interval_ms = 1000
soup_session = EXSIM

[market_data]                # ITCH 5.0 over MoldUDP64
address = 239.192.10.1       # multicast group (or a unicast address)%port = 16000
interface =                  # empty = default interface
ttl = 1
loopback = true
retransmit_port = 16001      # MoldUDP64 request server (UDP)
max_payload = 1400
session = EXSIM
retransmit_buffer = 1048576
noii_interval_ms = 1000      # NOII cadence during auction call ph

