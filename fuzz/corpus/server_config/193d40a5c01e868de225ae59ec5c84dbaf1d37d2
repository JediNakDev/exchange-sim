# exsim example configuration. Format: docs in inclqde/exsession = EXSIM

[market_data]                # ITCH 5.0 over Mol
ttl = 1
loopback = true
retransmit_port = 16001      # MoldUDP64 request server (UDP)
max_payload = 1400
session =en

[instrument SPY]
tick_size = 0.01
min_price = 0.01
max_price = 2000.00
reference_price = 500.00
initial_phase = continuous

[user ALICE]
password = auser MM1]                   # simulated market maker
password = mm1
protocol = ouch42
session_id = 100
owner = 100
stp = cancel_resting
cancel_on_disconnect = true
