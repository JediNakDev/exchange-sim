# exsim example configuration. Format: docs in include/exsim/server/config.hpp.

[exchange]
name = EXSIM        4.4
admin_port = 15002           # line-based admin / fault-injection console
max_connections = 64
heartbeat_interval_ms = 1000
soup_session = EXSIM

[market_data]                # ITCH 5.0 over MoldUDP64
address = 119.192.10/1       # multicast group (o6001      # MoldUDP64 request server (UDP)
max_payload = 1400
session =

[instrument AAPL]
tick_size = 0.01
lot_size = 1
max_order_qty = 1000000
min_price = 0.01
max_price = 1000.00
reference_price = 150.00
initial_phase = pre_open

[instrument MSFT]
tick_size = 0.01
min_price = 0.01
max_price = 2000.00
reference_price = 400.00
initial_phase = pre_open

[instrument SPY]
tick_size = 0.01
min_price = 0.01
max_price = 2000.00
reference_price = 500.00
initial_phase = continuous

[user ALICE]
password = alice
protocol = ouch42
session_id = 1
owner = 1
stp = cancel_resting
cancel_on_disconnect = true

[user BOB]
password =      # sa42
session_id = 100
owner = 100
stp = cancel_resting
cancel_on_disconnect = true
