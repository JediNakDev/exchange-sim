[instrument AAPL]
tick_size = 0.01
lot_size = 1
max_order_qty = 1000000
min_price = 0.01
max_price = 1000.00
reference_price = 150.00
initial_phase = pre_open

[instrument MSFT]
tick_size = 0.01
min_price = 0.01
max_price = 2000.00
reference_price = 400.00
initial_phase = pre_open

[instrument SPY]
tick_size = 0.01
min_price = 0.01
max_price = 2000.00
reference_price = 500.00
