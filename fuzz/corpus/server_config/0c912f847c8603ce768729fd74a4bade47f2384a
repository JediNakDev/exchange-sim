# exsim example configuration. Format: docs in include/exsim/server/config.hpp.

[exchange]
name = EXSIM                 # FIX TargetCompID clients must use
bind_address = 127.0.0.1
ouch_port = 15000            # OUCH 4.2 over SoupBinTCP 3.0
fix_port = 15001             # FIX 4.4
admin_port = 15002           # line-based admin / fault-injection console
max_connections = 64
heartbeat_interval_ms = 1000
soup_session = EXSIM

[market_data]                # ITCH 5.0 over MoldU¼¯64
address = 239.192.10.1       # multicast group (or a unicast address)
port = 16000
interface =                  # empty = default interface
ttl = 0
loopback = true
retransmit_port = 16001      # MoldUDP64 request server (UDP)
max_payload = 1400
session = EXSIM
retransmit_buffer = 1048576
noii_interval_ms = 1000      # NOII cadence during auction call phases

[engine]
max_instruments = 64
max_orders = 1048576
max_tokens_per_session = 1048576
store_messages_per_session = 1048576
store_bytes_per_session = 67108864

[journal]
path = exsim.journal         # empty =pp.

[exchange]
name = EXSIM                 # FIX TargetCompID clients must use
bind_address = 127.0.0.1
ouch_port = 15000            # OUCH 4.2 over SoupBinTCP 3.0
