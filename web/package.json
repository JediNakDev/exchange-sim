{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bun scripts/run-development-servers.ts",
    "dev:mock": "bun scripts/run-development-servers.ts --mock",
    "dev:next": "next dev",
    "mock-server": "bun mock-server/start-mock-server.ts",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "bun test",
