        <enum name="SelfTradePreventionEnum" encodingType="char" description="NUL (0) = use the user default">
            <validValue name="None">N</validValue>
            <validValue name="CancelResting">R</validValue>
            <validValue name="CancelAggressor">A</validValue>
            <validValue name="CancelBoth">B</validValue>
        </enum>
        <set name="ExecInstSet" encodingType="uint8">
            <choice name="ParticipateDontInitiate" description="FIX ExecInst 6, post only">0</choice>
        </set>
        <enum name="OrdStatusEnum" encodingType="char">
            <validValue name="New">0</validValue>
            <validValue name="PartiallyFilled">1</validValue>
            <validValue name="Filled">2</validValue>
            <validValue name="Canceled">4</validValue>
            <validValue name="Rejected">8</validValue>
        </enum>
        <enum name="ExecTypeEnum" encodingType="char">
            <validValue name="New">0</validValue>
            <validValue name="Canceled">4</validValue>
            <validValue name="Replaced">5</validValue>
            <validValue name="Rejected">8</validValue>
            <validValue name="Trade">F</validValue>
        </enum>
        <enum name="LastLiquidityIndEnum" encodingType="uint8">
            <validValue name="AddedLiquidity">1</validValue>
            <validValue name="RemovedLiquidity">2</validValue>
            <validValue name="Auction">4</validValue>
        </enum>
        <enum name="BooleanEnum" encodingType="uint8" description="SBE 4.13.6 Boolean">
            <validValue name="False">0</validValue>
            <validValue name="True">1</validValue>
        </enum>
        <enum name="OrdRejReasonEnum" encodingType="uint8">
            <validValue name="UnknownSymbol">1</validValue>
            <validValue name="ExchangeClosed">2</validValue>
            <validValue name="UnknownOrder">5</validValue>
            <validValue name="DuplicateOrder">6</validValue>
            <validValue name="Other">99</validValue>
        </enum>
        <enum name="CxlRejResponseToEnum" encodingType="char">
            <validValue name="OrderCancelRequest">1</validValue>
            <validValue name="OrderCancelReplaceRequest">2</validValue>
        </enum>
        <enum name="CxlRejReasonEnum" encodingType="uint8">
            <validValue name="UnknownOrder">1</validValue>
            <validValue name="DuplicateClOrdId">6</validValue>
            <validValue name="Other">99</validValue>
        </enum>
        <enum name="MassCancelRequestTypeEnum" encodingType="char">
            <validValue name="CancelOrdersForSecurity">1</validValue>
            <validValue name="CancelAllOrders">7</validValue>
        </enum>
        <enum name="MassCancelResponseEnum" encodingType="char">
            <validValue name="CancelRequestRejected">0</validValue>
            <validValue name="CancelOrdersForSecurity">1</validValue>
            <validValue name="CancelAllOrders">7</validValue>
        </enum>
        <enum name="MassCancelRejectReasonEnum" encodingType="uint8" description="255 = null (request accepted)">
            <validValue name="MassCancelNotSupported">0</validValue>
            <validValue name="InvalidOrUnknownSecurity">1</validValue>
            <validValue name="Other">99</validValue>
        </enum>
        <enum name="BusinessRejectReasonEnum" encodingType="uint8">
            <validValue name="Other">0</validValue>
            <validValue name="UnsupportedMessageType">3</validValue>
        </enum>
        <enum name="ExsimCancelReasonEnum" encodingType="uint8" description="Values equal exsim::CancelReason">
            <validValue name="UserRequested">0</validValue>
            <validValue name="ImmediateOrCancel">1</validValue>
            <validValue name="FillOrKill">2</validValue>
            <validValue name="SelfTradePrevention">3</validValue>
            <validValue name="MassCancel">4</validValue>
            <validValue name="CancelOnDisconnect">5</validValue>
            <validValue name="EndOfDay">6</validValue>
        </enum>
        <enum name="ExsimRejectReasonEnum" encodingType="uint8"
              description="1..12 equal exsim::RejectReason (engine); 64 and above are gateway reasons">
            <validValue name="None">0</validValue>
            <validValue name="UnknownInstrument">1</validValue>
            <validValue name="InvalidClOrdId">2</validValue>
            <validValue name="DuplicateClOrdId">3</validValue>
            <validValue name="InvalidQuantity">4</validValue>
            <validValue name="InvalidPrice">5</validValue>
            <validValue name="InvalidField">6</validValue>
            <validValue name="MarketClosed">7</validValue>
            <validValue name="InstrumentHalted">8</validValue>
            <validValue name="NotAllowedInPhase">9</validValue>
            <validValue name="PostOnlyWouldCross">10</validValue>
            <validValue name="CapacityExceeded">11</validValue>
            <validValue name="UnknownOrder">12</validValue>
            <validValue name="ClOrdIdAlreadyUsedToday">64</validValue>
            <validValue name="TokenTableFull">65</validValue>
            <validValue name="OutboundStoreFull">66</validValue>
            <validValue name="InjectedReject">67</validValue>
            <validValue name="RequestHadNoEffect">69</validValue>
        </enum>
    </types>

