<?xml version="1.0" encoding="UTF-8"?>
<!--
  exsim binary order entry: SBE 1.0 application messages over a FIXP 1.0 session.

  This schema is owned by exsim. It follows only the open FIX Trading Community
  standards and copies no venue schema:
    * Simple Binary Encoding (SBE) 1.0 with the November 2020 errata.
    * FIX Performance Session Layer (FIXP) 1.0. The session message layouts and
      template ids 1..18 are the ones of the FIXP 1.0 reference SBE schema
      (package FIXP); they are re-declared here under the exsim schema id so that
      one message header and one schema id cover the whole TCP stream.
    * Simple Open Framing Header (SOFH) 1.0.

  Framing (SOFH 1.0, "Encoding of the Simple Open Framing Header"): every message
  is preceded by 6 bytes, Message_Length uint32 big-endian (counts the SOFH, the
  SBE message header, the root block and any variable length data) and
  Encoding_Type uint16 big-endian 0xEB50 (SBE 1.0 little-endian). SOFH is the
  only big-endian structure on the wire; every SBE field is little-endian.

  Message header: the SBE 1.0 recommended 12 byte header (SBE 5.2.1).
  Application messages are fixed length (numGroups = 0, numVarDataFields = 0).
  Session messages carry at most one variable length field (Credentials or
  Reason). No repeating groups are used anywhere.

  Extension rule (SBE 7.3.1 and 7.4): a later version may only append fields to
  a root block or append variable length fields. Decoders use the header
  blockLength to skip unknown trailing block bytes. Version 1 decoders reject
  messages whose header version is 0.

  Template id ranges: 1..99 FIXP session layer, 100..199 client to server
  application messages, 200..299 server to client application messages.

  Custom field ids 7900..7999 are exsim user defined tags (FIX user defined
  range 5000..9999). Tag 7928 SelfTradePrevention is shared with the exsim
  FIX 4.4 gateway.
-->
<sbe:messageSchema xmlns:sbe="http://fixprotocol.io/2016/sbe"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   package="exsim_order_entry"
                   id="22597"
                   version="1"
                   semanticVersion="FIXP 1.0 SBE 1.0"
                   description="exsim order entry (wire bytes of schema id 22597 read 'EX' in little-endian)"
                   byteOrder="littleEndian"
                   headerType="messageHeader"
                   xsi:schemaLocation="http://fixprotocol.io/2016/sbe sbe.xsd">
    <types>
        <!-- SBE 5.2.1 recommended message header, 12 bytes. -->
        <composite name="messageHeader" description="Template id and length of message root">
            <type name="blockLength" primitiveType="uint16"/>
            <type name="templateId" primitiveType="uint16"/>
            <type name="schemaId" primitiveType="uint16"/>
            <type name="version" primitiveType="uint16"/>
            <type name="numGroups" primitiveType="uint16"/>
            <type name="numVarDataFields" primitiveType="uint16"/>
        </composite>

        <!-- FIXP 1.0 session types (FIXP reference schema). -->
        <type name="UUID" primitiveType="uint8" length="16" description="RFC 4122 version 4 session identifier"/>
        <type name="nanotime" primitiveType="uint64" description="Nanoseconds since the Unix epoch"/>
        <type name="DeltaMillisecs" primitiveType="uint32" description="Time interval in milliseconds"/>
        <type name="ordinal" primitiveType="uint64" description="Sequence number"/>
        <type name="ordinalOptional" primitiveType="uint64" presence="optional" nullValue="18446744073709551615"/>
        <type name="cardinal" primitiveType="uint32" description="Message count"/>
        <composite name="Object" description="Variable length octet string (SBE 4.8.2); at most 128 bytes in exsim">
            <type name="length" primitiveType="uint16" maxValue="128" semanticType="Length"/>
            <type name="varData" length="0" primitiveType="uint8" semanticType="data"/>
        </composite>
        <composite name="CharacterString" description="Variable length ASCII text (SBE 4.8.2); at most 128 bytes in exsim">
            <type name="length" primitiveType="uint16" maxValue="128" semanticType="Length"/>
            <type name="varData" length="0" primitiveType="char" semanticType="String"/>
        </composite>
        <enum name="FlowType" encodingType="uint8">
            <validValue name="Recoverable">0</validValue>
            <validValue name="Idempotent">1</validValue>
            <validValue name="Unsequenced">2</validValue>
            <validValue name="None">3</validValue>
        </enum>
        <enum name="NegotiationRejectCode" encodingType="uint8">
            <validValue name="Credentials">0</validValue>
            <validValue name="FlowTypeNotSupported">1</validValue>
            <validValue name="DuplicateId">2</validValue>
            <validValue name="Unspecified">3</validValue>
        </enum>
        <enum name="EstablishmentRejectCode" encodingType="uint8">
            <validValue name="Unnegotiated">0</validValue>
            <validValue name="AlreadyEstablished">1</validValue>
            <validValue name="SessionBlocked">2</validValue>
            <validValue name="KeepaliveInterval">3</validValue>
            <validValue name="Credentials">4</validValue>
            <validValue name="Unspecified">5</validValue>
        </enum>
        <enum name="RetransmitRejectCode" encodingType="uint8">
            <validValue name="OutOfRange">0</validValue>
            <validValue name="InvalidSession">1</validValue>
            <validValue name="RequestLimitExceeded">2</validValue>
        </enum>
        <enum name="TerminationCode" encodingType="uint8">
            <validValue name="Finished">0</validValue>
            <validValue name="UnspecifiedError">1</validValue>
            <validValue name="ReRequestOutOfBounds">2</validValue>
            <validValue name="ReRequestInProgress">3</validValue>
        </enum>

        <!-- Application types. -->
        <type name="ClOrdIdType" primitiveType="uint64" minValue="1"
              description="Client order token; 0 is invalid; never reused by one user within a trading day"/>
        <type name="ClOrdIdOptional" primitiveType="uint64" presence="optional" nullValue="0"/>
        <type name="OrderIdType" primitiveType="uint64" description="Exchange order id; 0 = none"/>
        <type name="ExecIdType" primitiveType="uint64" description="Unique per user per trading day"/>
        <type name="MatchIdType" primitiveType="uint64"/>
        <type name="SeqNumType" primitiveType="uint64"/>
        <type name="TemplateIdType" primitiveType="uint16"/>
        <type name="Qty" primitiveType="uint32"/>
        <type name="QtyOptional" primitiveType="uint32" presence="optional" nullValue="0"
              description="0 = absent"/>
        <type name="Count" primitiveType="uint32"/>
        <type name="SymbolType" primitiveType="char" length="8" characterEncoding="US-ASCII"
              description="Instrument symbol, NUL padded (SBE 4.7.2); trailing spaces are also accepted"/>

        <!-- SBE 4.5 decimal with constant exponent: wire size 8 bytes. -->
        <composite name="Price" description="Price = mantissa * 10^-4">
            <type name="mantissa" primitiveType="int64"/>
            <type name="exponent" primitiveType="int8" presence="constant">-4</type>
        </composite>
        <composite name="PriceOptional" description="Price = mantissa * 10^-4; mantissa INT64_MIN = null">
            <type name="mantissa" primitiveType="int64" presence="optional" nullValue="-9223372036854775808"/>
            <type name="exponent" primitiveType="int8" presence="constant">-4</type>
        </composite>
        <!-- SBE 4.10.3 UTCTimestamp with constant unit: wire size 8 bytes. -->
        <composite name="UTCTimestampNanos" description="Nanoseconds since the Unix epoch">
            <type name="time" primitiveType="uint64"/>
            <type name="unit" primitiveType="uint8" presence="constant">9</type>
        </composite>

        <enum name="SideEnum" encodingType="char">
            <validValue name="Buy">1</validValue>
            <validValue name="Sell">2</validValue>
        </enum>
        <enum name="OrdTypeEnum" encodingType="char">
            <validValue name="Market">1</validValue>
            <validValue name="Limit">2</validValue>
        </enum>
        <enum name="TimeInForceEnum" encodingType="char">
