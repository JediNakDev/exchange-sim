# SPEC 7: cancel every live order of the session (optionally one instrument) in
# ascending OrderId order, then MassCancelDone with instrument=cmd.instrument.
# Never rejected; allowed in every phase. A priority-loss replace gets a higher
# OrderId, so it is canceled after orders that were placed later.
instrument AAA tick=0.01 lot=1 max_qty=100 min=99 max=101 ref=100 phase=CONTINUOUS
instrument BBB tick=0.01 lot=1 max_qty=100 min=99 max=101 ref=100 phase=CONTINUOUS
session alice firmA
session bob firmB
NEW_ORDER instrument=AAA session=alice cl_ord_id=a1 side=BUY qty=1 price=100
NEW_ORDER instrument=BBB session=alice cl_ord_id=b1 side=BUY qty=1 price=100
NEW_ORDER instrument=AAA session=bob cl_ord_id=x side=BUY qty=1 price=100
NEW_ORDER instrument=AAA session=alice cl_ord_id=a2 side=BUY qty=1 price=99
REPLACE session=alice orig_cl_ord_id=a1 qty=1 price=100 force_priority_loss=true
expect replaced old_order_id=1 new_order_id=5
MASS_CANCEL session=alice instrument=AAA cl_ord_id=m1 ts=8
expect count 3
expect canceled instrument=AAA ts=8 order_id=4 cl_ord_id=a2 request_cl_ord_id=m1 session=alice side=BUY price=99 canceled_qty=1 cum_qty=0 reason=MASS_CANCEL was_resting=true leaves_qty=0
expect canceled instrument=AAA order_id=5 cl_ord_id=a1 request_cl_ord_id=m1 reason=MASS_CANCEL
expect mass_cancel_done instrument=AAA ts=8 session=alice request_cl_ord_id=m1 canceled_count=2 reason=MASS_CANCEL
expect depth AAA bid 100:1:1
# unknown instrument matches nothing and is not rejected
MASS_CANCEL session=alice instrument=99 cl_ord_id=m2
expect count 1
expect mass_cancel_done instrument=99 session=alice request_cl_ord_id=m2 canceled_count=0 reason=MASS_CANCEL
# instrument 0 = all instruments; cancel-on-disconnect selects the reason
MASS_CANCEL session=alice cl_ord_id=m3 cancel_on_disconnect=true
expect count 2
expect canceled instrument=BBB order_id=2 cl_ord_id=b1 request_cl_ord_id=m3 reason=CANCEL_ON_DISCONNECT
expect mass_cancel_done instrument=0 session=alice request_cl_ord_id=m3 canceled_count=1 reason=CANCEL_ON_DISCONNECT
# allowed while Halted
SET_PHASE instrument=AAA phase=HALTED
MASS_CANCEL session=bob instrument=AAA
expect count 2
expect canceled order_id=3 cl_ord_id=x request_cl_ord_id=0 reason=MASS_CANCEL
expect mass_cancel_done instrument=AAA session=bob request_cl_ord_id=0 canceled_count=1
MASS_CANCEL session=0
expect count 1
expect mass_cancel_done instrument=0 session=0 canceled_count=0
