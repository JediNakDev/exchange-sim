# SPEC 12: side-volume, FOK and auction sums use uint64. Two UINT32_MAX orders per
# side make level and auction totals exceed 2^32; FOK availability 1 + UINT32_MAX
# must not wrap to 0.
instrument AAA tick=0.01 lot=1 max_qty=4294967295 min=99 max=101 ref=100 phase=PRE_OPEN
session alice firmA
session bob firmB
NEW_ORDER instrument=AAA session=alice cl_ord_id=b1 side=BUY qty=4294967295 price=101
NEW_ORDER instrument=AAA session=bob cl_ord_id=b2 side=BUY qty=4294967295 price=101
NEW_ORDER instrument=AAA session=alice cl_ord_id=s1 side=SELL qty=4294967295 price=99
NEW_ORDER instrument=AAA session=bob cl_ord_id=s2 side=SELL qty=4294967295 price=99
expect depth AAA bid 101:8589934590:2
expect depth AAA ask 99:8589934590:2
SET_PHASE instrument=AAA phase=CONTINUOUS
expect count 4
expect fill match_id=1 price=99 qty=4294967295 buy.order_id=1 sell.order_id=3
expect fill match_id=2 price=99 qty=4294967295 buy.order_id=2 sell.order_id=4
expect auction_summary price=99 matched_qty=8589934590 match_id=3
expect phase_changed
NEW_ORDER instrument=AAA session=bob cl_ord_id=x1 side=SELL qty=1 price=100
NEW_ORDER instrument=AAA session=bob cl_ord_id=x2 side=SELL qty=4294967295 price=100
expect depth AAA ask 100:4294967296:2
NEW_ORDER instrument=AAA session=alice tif=FOK cl_ord_id=f side=BUY qty=4294967295 price=100
expect count 3
expect accepted order_id=7
expect fill match_id=4 qty=1 buy.leaves_qty=4294967294 sell.order_id=5
expect fill match_id=5 qty=4294967294 buy.leaves_qty=0 buy.cum_qty=4294967295 sell.order_id=6 sell.leaves_qty=1
expect depth AAA ask 100:1:1
