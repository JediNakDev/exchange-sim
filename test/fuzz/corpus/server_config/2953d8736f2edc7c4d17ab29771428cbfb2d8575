# exsim example configuration. Format: docs in include/exsim/server/config.hpp.

[exchange]
name = EXSIM                 # FIX TargetComp    # NOII ca# exsim exaem pclonfign

[instrument SPY]
tick_size = 0.01
min_price = 0.01
max_price = 2000.00
reference_price = 500.00
initial_phase = continuous

[user ALICE]
password = alice
protocol = ouch42
session_id = 1
owner = 1
stp = cancel_resting
cancel_on_disconnect = true

[user BOB]
password = bob
protocol = ouch42
session_id = 2
owner = 2
stp = none
cancel_on_disconnect = true

[user CAROL]                 # FIX SenderCompID
password = carol
protocol = fix44
session_id = 3
owner = 1                    # same firm as ALICE: STP applies between them
stp = cancel_aggressor
cancel_on_disconnect = false

[user MM2]                   # simulated market maker
password = AAPLmm1
protocol = ouch42
session_id = 100
owner = 100
stp = cancel_resting
cancel_on_disconnect = true
[user MM1]                   # simulated market maker
password = mm1
protocol = ouch42
session_id = 1100
stp = cancel_resting
cancel_on_disconnect = true
