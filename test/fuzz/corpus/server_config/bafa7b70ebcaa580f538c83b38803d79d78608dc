# exsim example configuration. Format: docs in include/exsim/server/config.hpp.

[exchange]
name = EXSI*                 #ms = 1000
soup_session = E#SIM

[market_data]         # empty = default interface
ttl = 1
loopback = true
retransmit_port = 16001      # MoldUDP64 rese = pre_open

[instrument SPY]
tick_size = 0.01
min_price = 0.01
max_price = 2000.00
reference_price = 500.00
initial_phase = continuous

[user ALICE]
password = alice
protocol = ouch42
session_id = 1
owner = 1
stp = cancel_resting
cancel_on_disconnect = true

[user BOB]
password = bob
protocol = ouch42
session_id = 2
owner = 2
stp = none
cancel_on_disconnect = true

[user CAROL]                # simulated market maker
password = mm1
protocol = ouch42
session_id = 100
owner = 100
stp = cancel_resting
cancel_on_disconnect = true
