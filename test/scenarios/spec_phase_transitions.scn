# SPEC 3, 8, 9, 12: SetPhase rejection order and fields, same-phase no-op,
# all-instrument batches in ascending id, call phases keep a crossed book,
# PreOpen -> PreClose -> Halted preserves the cross, entering Continuous or Closed
# uncrosses (STP not applied), noncrossed transitions consume no MatchId, Closed
# expires DAY orders in ascending OrderId after the uncross.
config max_orders=128 max_instruments=3
instrument AAA tick=0.01 lot=1 max_qty=100 min=99 max=101 ref=100 phase=CONTINUOUS
instrument BBB tick=0.01 lot=1 max_qty=100 min=99 max=101 ref=100 phase=PRE_OPEN
instrument CCC tick=0.01 lot=1 max_qty=100 min=99 max=101 ref=100 phase=CLOSED
session alice firmA
session bob firmB
SET_PHASE instrument=99 phase=CONTINUOUS ts=5
expect count 1
expect rejected instrument=99 ts=5 cmd=SET_PHASE reason=UNKNOWN_INSTRUMENT session=0 cl_ord_id=0 orig_cl_ord_id=0 order_id=0
SET_PHASE instrument=99 phase=9
expect count 1
expect rejected instrument=99 reason=UNKNOWN_INSTRUMENT
SET_PHASE instrument=AAA phase=9
expect count 1
expect rejected instrument=AAA cmd=SET_PHASE reason=INVALID_FIELD session=0 cl_ord_id=0 orig_cl_ord_id=0 order_id=0
SET_PHASE instrument=0 phase=7
expect count 1
expect rejected instrument=0 reason=INVALID_FIELD
SET_PHASE instrument=AAA phase=CONTINUOUS
expect no events
# all instruments, ascending id; BBB already PRE_OPEN emits nothing
SET_PHASE instrument=0 phase=PRE_OPEN ts=6
expect count 2
expect phase_changed instrument=AAA ts=6 old_phase=CONTINUOUS new_phase=PRE_OPEN
expect phase_changed instrument=CCC ts=6 old_phase=CLOSED new_phase=PRE_OPEN
# call phase: crossing orders rest; post-only has no cross check; same-owner STP orders rest
NEW_ORDER instrument=AAA session=alice owner=firmA stp=CANCEL_BOTH cl_ord_id=s side=SELL qty=10 price=99
expect count 2
expect accepted order_id=1
expect rested order_id=1
NEW_ORDER instrument=AAA session=alice owner=firmA stp=CANCEL_BOTH post_only=true cl_ord_id=b side=BUY qty=10 price=101
expect count 2
expect accepted order_id=2 post_only=true
expect rested order_id=2 price=101 leaves_qty=10
NEW_ORDER instrument=AAA session=alice tif=FOK cl_ord_id=f side=BUY qty=1 price=101
expect count 1
expect rejected reason=NOT_ALLOWED_IN_PHASE
# call to call: no uncross
SET_PHASE instrument=AAA phase=PRE_CLOSE
expect count 1
expect phase_changed old_phase=PRE_OPEN new_phase=PRE_CLOSE
NEW_ORDER instrument=AAA session=bob cl_ord_id=h side=BUY qty=1 price=99.01
expect accepted order_id=3
# call to Halted: crossed book preserved without matching (SPEC 12)
SET_PHASE instrument=AAA phase=HALTED
expect count 1
expect phase_changed old_phase=PRE_CLOSE new_phase=HALTED
expect depth AAA bid 101:10:1 99.01:1:1
expect depth AAA ask 99:10:1
NEW_ORDER instrument=AAA session=bob cl_ord_id=h2 side=BUY qty=1 price=100
expect count 1
expect rejected reason=INSTRUMENT_HALTED
CANCEL session=bob orig_cl_ord_id=h
expect count 1
expect canceled order_id=3 reason=USER_REQUESTED
# Halted -> Continuous uncrosses: 99 and 101 tie on V=10, |I|=0 and distance 1 to ref 100,
# so the lower price 99 wins; same-owner CancelBoth orders still trade
SET_PHASE instrument=AAA phase=CONTINUOUS ts=7
expect count 3
expect fill instrument=AAA ts=7 match_id=1 price=99 qty=10 aggressor=NONE buy.order_id=2 buy.cl_ord_id=b buy.session=alice buy.owner=firmA buy.leaves_qty=0 buy.cum_qty=10 sell.order_id=1 sell.cl_ord_id=s sell.session=alice sell.owner=firmA sell.leaves_qty=0 sell.cum_qty=10
expect auction_summary instrument=AAA ts=7 price=99 matched_qty=10 match_id=2
expect phase_changed instrument=AAA ts=7 old_phase=HALTED new_phase=CONTINUOUS
expect depth AAA bid
expect depth AAA ask
# noncrossed PreOpen -> Continuous: no summary, no MatchId consumed
NEW_ORDER instrument=BBB session=alice cl_ord_id=bb side=BUY qty=5 price=100
SET_PHASE instrument=BBB phase=CONTINUOUS
expect count 1
expect phase_changed instrument=BBB old_phase=PRE_OPEN new_phase=CONTINUOUS
NEW_ORDER instrument=BBB session=bob cl_ord_id=bs side=SELL qty=5 price=100
expect count 2
expect accepted order_id=5
expect fill match_id=3 qty=5
# CCC PreOpen -> Closed: candidates 99,99.5,99.6,100 have V=5; 100.5 and 101 have V=10,|I|=0;
# 100.5 is closer to 100. Fills, summary, DAY expiry (ascending OrderId, not price), phase.
NEW_ORDER instrument=CCC session=alice cl_ord_id=c1 side=BUY qty=10 price=101
NEW_ORDER instrument=CCC session=alice tif=GTC cl_ord_id=c2 side=BUY qty=5 price=100
NEW_ORDER instrument=CCC session=bob cl_ord_id=c3 side=SELL qty=5 price=99
NEW_ORDER instrument=CCC session=bob tif=GTC cl_ord_id=c4 side=SELL qty=5 price=100.5
NEW_ORDER instrument=CCC session=bob cl_ord_id=c5 side=BUY qty=1 price=99.5
NEW_ORDER instrument=CCC session=alice cl_ord_id=c6 side=BUY qty=1 price=99.6
SET_PHASE instrument=CCC phase=CLOSED
expect count 6
expect fill instrument=CCC match_id=4 price=100.5 qty=5 aggressor=NONE buy.order_id=6 buy.leaves_qty=5 buy.cum_qty=5 sell.order_id=8 sell.leaves_qty=0 sell.cum_qty=5
expect fill instrument=CCC match_id=5 price=100.5 qty=5 aggressor=NONE buy.order_id=6 buy.leaves_qty=0 buy.cum_qty=10 sell.order_id=9 sell.leaves_qty=0 sell.cum_qty=5
expect auction_summary instrument=CCC price=100.5 matched_qty=10 match_id=6
expect canceled instrument=CCC order_id=10 cl_ord_id=c5 reason=END_OF_DAY was_resting=true canceled_qty=1 request_cl_ord_id=0
expect canceled instrument=CCC order_id=11 cl_ord_id=c6 reason=END_OF_DAY
expect phase_changed instrument=CCC old_phase=PRE_OPEN new_phase=CLOSED
expect depth CCC bid 100:5:1
expect depth CCC ask
# all-instrument close with empty books: one PhaseChanged per changed instrument
SET_PHASE instrument=0 phase=CLOSED
expect count 2
expect phase_changed instrument=AAA old_phase=CONTINUOUS new_phase=CLOSED
expect phase_changed instrument=BBB old_phase=CONTINUOUS new_phase=CLOSED
