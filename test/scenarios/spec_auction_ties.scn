# SPEC 9: candidates are only prices in [best_ask, best_bid] where an order rests;
# maximise V, then minimise |I|, then distance to reference, then lower price.
# Execution pairs best buy with best sell (price then FIFO) at p*, no STP; summary
# after fills. One all-instrument SetPhase processes instruments in ascending id (SPEC 8).
config max_orders=128 max_instruments=5
instrument AAA tick=0.01 lot=1 max_qty=100 min=99 max=101 ref=100 phase=PRE_OPEN
instrument BBB tick=0.01 lot=1 max_qty=100 min=99 max=101 ref=100.5 phase=PRE_OPEN
instrument CCC tick=0.01 lot=1 max_qty=100 min=99 max=101 ref=99 phase=PRE_OPEN
instrument DDD tick=0.01 lot=1 max_qty=100 min=99 max=101 ref=100 phase=PRE_OPEN
instrument EEE tick=0.01 lot=1 max_qty=100 min=99 max=101 ref=100 phase=PRE_OPEN
session alice firmA
session bob firmB
# AAA/BBB: V(99)=V(101)=10 with I=+5 and I=-5 (equal |I|, opposite sign)
NEW_ORDER instrument=AAA session=alice cl_ord_id=a1 side=BUY qty=10 price=101
NEW_ORDER instrument=AAA session=alice cl_ord_id=a2 side=BUY qty=5 price=99
NEW_ORDER instrument=AAA session=bob cl_ord_id=a3 side=SELL qty=10 price=99
NEW_ORDER instrument=AAA session=bob cl_ord_id=a4 side=SELL qty=5 price=101
NEW_ORDER instrument=BBB session=alice cl_ord_id=b1 side=BUY qty=10 price=101
NEW_ORDER instrument=BBB session=alice cl_ord_id=b2 side=BUY qty=5 price=99
NEW_ORDER instrument=BBB session=bob cl_ord_id=b3 side=SELL qty=10 price=99
NEW_ORDER instrument=BBB session=bob cl_ord_id=b4 side=SELL qty=5 price=101
# CCC: touching book (bid == ask) is crossed; single candidate
NEW_ORDER instrument=CCC session=alice cl_ord_id=c1 side=BUY qty=10 price=100
NEW_ORDER instrument=CCC session=bob cl_ord_id=c2 side=SELL qty=4 price=100
# DDD: 99 and 101 are outside [99.5, 100.5]; 100 (distance 0) is not a candidate
NEW_ORDER instrument=DDD session=alice cl_ord_id=d1 side=BUY qty=10 price=100.5
NEW_ORDER instrument=DDD session=alice cl_ord_id=d2 side=BUY qty=3 price=99
NEW_ORDER instrument=DDD session=bob cl_ord_id=d3 side=SELL qty=10 price=99.5
NEW_ORDER instrument=DDD session=bob cl_ord_id=d4 side=SELL qty=3 price=101
# EEE: V(99)=3, V(100)=11, V(101)=10 => 100; FIFO pairing, partial legs, same-owner trade
NEW_ORDER instrument=EEE session=alice owner=firmA stp=CANCEL_BOTH cl_ord_id=e1 side=BUY qty=4 price=101
NEW_ORDER instrument=EEE session=bob cl_ord_id=e2 side=BUY qty=6 price=101
NEW_ORDER instrument=EEE session=bob cl_ord_id=e3 side=BUY qty=5 price=100
NEW_ORDER instrument=EEE session=alice owner=firmA stp=CANCEL_BOTH cl_ord_id=e4 side=SELL qty=3 price=99
NEW_ORDER instrument=EEE session=bob cl_ord_id=e5 side=SELL qty=8 price=100
SET_PHASE instrument=0 phase=CONTINUOUS ts=40
expect count 18
# AAA: distance tie (1 and 1) => lower price 99
expect fill instrument=AAA ts=40 match_id=1 price=99 qty=10 aggressor=NONE buy.order_id=1 buy.leaves_qty=0 buy.cum_qty=10 sell.order_id=3 sell.leaves_qty=0 sell.cum_qty=10
expect auction_summary instrument=AAA price=99 matched_qty=10 match_id=2
expect phase_changed instrument=AAA old_phase=PRE_OPEN new_phase=CONTINUOUS
# BBB: reference 100.5 => 101 (distance 0.5 vs 1.5)
expect fill instrument=BBB match_id=3 price=101 qty=10 buy.order_id=5 sell.order_id=7
expect auction_summary instrument=BBB price=101 matched_qty=10 match_id=4
expect phase_changed instrument=BBB
expect fill instrument=CCC match_id=5 price=100 qty=4 buy.order_id=9 buy.leaves_qty=6 buy.cum_qty=4 sell.order_id=10 sell.leaves_qty=0
expect auction_summary instrument=CCC price=100 matched_qty=4 match_id=6
expect phase_changed instrument=CCC
expect fill instrument=DDD match_id=7 price=99.5 qty=10 buy.order_id=11 sell.order_id=13
expect auction_summary instrument=DDD price=99.5 matched_qty=10 match_id=8
expect phase_changed instrument=DDD
expect fill instrument=EEE match_id=9 price=100 qty=3 aggressor=NONE buy.order_id=15 buy.owner=firmA buy.leaves_qty=1 buy.cum_qty=3 sell.order_id=18 sell.owner=firmA sell.leaves_qty=0 sell.cum_qty=3
expect fill instrument=EEE match_id=10 price=100 qty=1 buy.order_id=15 buy.leaves_qty=0 buy.cum_qty=4 sell.order_id=19 sell.leaves_qty=7 sell.cum_qty=1
expect fill instrument=EEE match_id=11 price=100 qty=6 buy.order_id=16 buy.leaves_qty=0 buy.cum_qty=6 sell.order_id=19 sell.leaves_qty=1 sell.cum_qty=7
expect fill instrument=EEE match_id=12 price=100 qty=1 buy.order_id=17 buy.leaves_qty=4 buy.cum_qty=1 sell.order_id=19 sell.leaves_qty=0 sell.cum_qty=8
expect auction_summary instrument=EEE price=100 matched_qty=11 match_id=13
expect phase_changed instrument=EEE old_phase=PRE_OPEN new_phase=CONTINUOUS
expect depth AAA bid 99:5:1
expect depth AAA ask 101:5:1
expect depth BBB bid 99:5:1
expect depth BBB ask 101:5:1
expect depth CCC bid 100:6:1
expect depth CCC ask
expect depth DDD bid 99:3:1
expect depth DDD ask 101:3:1
expect depth EEE bid 100:4:1
expect depth EEE ask
