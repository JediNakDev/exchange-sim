# SPEC 12: PreOpen -> Halted keeps the crossed book; Halted -> Closed uncrosses, then
# expires DAY orders; GTC remainder survives. V ties at 4 for 99, 99.5 and 101;
# |I| is 8, 8, 6, so 101 wins before the reference tie-break (which would favour 99.5).
instrument AAA tick=0.01 lot=1 max_qty=100 min=99 max=101 ref=100 phase=PRE_OPEN
session alice firmA
session bob firmB
NEW_ORDER instrument=AAA session=alice tif=GTC cl_ord_id=g side=BUY qty=10 price=101
NEW_ORDER instrument=AAA session=bob cl_ord_id=s side=SELL qty=4 price=99
NEW_ORDER instrument=AAA session=alice cl_ord_id=d side=BUY qty=2 price=99.5
SET_PHASE instrument=AAA phase=HALTED
expect count 1
expect phase_changed old_phase=PRE_OPEN new_phase=HALTED
expect depth AAA bid 101:10:1 99.5:2:1
expect depth AAA ask 99:4:1
SET_PHASE instrument=AAA phase=CLOSED
expect count 4
expect fill match_id=1 price=101 qty=4 aggressor=NONE buy.order_id=1 buy.leaves_qty=6 buy.cum_qty=4 sell.order_id=2 sell.leaves_qty=0 sell.cum_qty=4
expect auction_summary price=101 matched_qty=4 match_id=2
expect canceled order_id=3 cl_ord_id=d reason=END_OF_DAY canceled_qty=2 was_resting=true
expect phase_changed old_phase=HALTED new_phase=CLOSED
expect depth AAA bid 101:6:1
expect depth AAA ask
expect order session=alice cl_ord_id=g qty=10 cum_qty=4 leaves_qty=6
