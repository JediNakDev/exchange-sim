instrument AAA tick=0.01 lot=1 max_qty=100 min=99 max=101 ref=100 phase=CONTINUOUS
session alice own
session bob own2
NEW_ORDER instrument=AAA session=alice cl_ord_id=a side=BUY qty=10 price=100
NEW_ORDER instrument=AAA session=alice cl_ord_id=b side=BUY qty=10 price=100
MASS_CANCEL session=alice cancel_on_disconnect=true
expect count 3
expect canceled cl_ord_id=a reason=CANCEL_ON_DISCONNECT
expect canceled cl_ord_id=b
expect mass_cancel_done canceled_count=2
