# SPEC 4.2 runs the FOK pre-check "if tif == FOK" without excluding market orders;
# SPEC 4.6 says a market order's TIF is ignored only for disposition. This scenario
# asserts that literal reading (see SPEC_CONFORMANCE.md ambiguity A1).
instrument AAA tick=0.01 lot=1 max_qty=100 min=99 max=101 ref=100 phase=CONTINUOUS
session alice firmA
session bob firmB
NEW_ORDER instrument=AAA session=bob cl_ord_id=o1 side=SELL qty=5 price=100
NEW_ORDER instrument=AAA session=bob cl_ord_id=o2 side=SELL qty=5 price=101
NEW_ORDER instrument=AAA session=alice type=MARKET tif=FOK cl_ord_id=m1 side=BUY qty=11 price=0
expect count 2
expect accepted order_id=3 ord_type=MARKET tif=FOK
expect canceled order_id=3 canceled_qty=11 cum_qty=0 reason=FILL_OR_KILL was_resting=false price=0
expect depth AAA ask 100:5:1 101:5:1
NEW_ORDER instrument=AAA session=alice type=MARKET tif=FOK cl_ord_id=m2 side=BUY qty=10 price=0
expect count 3
expect accepted order_id=4
expect fill match_id=1 price=100 qty=5
expect fill match_id=2 price=101 qty=5 buy.leaves_qty=0 buy.cum_qty=10
