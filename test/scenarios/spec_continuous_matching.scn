# SPEC 4.5/4.6: trades at the resting price, aggressor side and leg orientation,
# IOC dispositions, sweep then rest at the limit, token reuse among live orders only.
instrument AAA tick=0.01 lot=1 max_qty=100 min=99 max=101 ref=100 phase=CONTINUOUS
instrument BBB tick=0.01 lot=1 max_qty=100 min=99 max=101 ref=100 phase=CONTINUOUS
session alice firmA
session bob firmB
NEW_ORDER instrument=AAA session=bob cl_ord_id=o1 side=SELL qty=5 price=99.5
NEW_ORDER instrument=AAA session=alice cl_ord_id=b1 side=BUY qty=5 price=100.5 ts=3
expect count 2
expect accepted order_id=2
expect fill instrument=AAA ts=3 match_id=1 price=99.5 qty=5 aggressor=BUY buy.order_id=2 buy.cl_ord_id=b1 buy.session=alice buy.leaves_qty=0 buy.cum_qty=5 sell.order_id=1 sell.cl_ord_id=o1 sell.session=bob sell.leaves_qty=0 sell.cum_qty=5
# sell aggressor: buy leg is the resting order, trade at the resting (higher) price
NEW_ORDER instrument=AAA session=alice cl_ord_id=b2 side=BUY qty=5 price=100
NEW_ORDER instrument=AAA session=bob cl_ord_id=s1 side=SELL qty=3 price=99
expect count 2
expect accepted order_id=4
expect fill match_id=2 price=100 qty=3 aggressor=SELL buy.order_id=3 buy.cl_ord_id=b2 buy.session=alice buy.leaves_qty=2 buy.cum_qty=3 sell.order_id=4 sell.cl_ord_id=s1 sell.session=bob sell.leaves_qty=0 sell.cum_qty=3
# IOC that does not cross: whole quantity canceled
NEW_ORDER instrument=AAA session=bob tif=IOC cl_ord_id=s2 side=SELL qty=5 price=100.01
expect count 2
expect accepted order_id=5 tif=IOC
expect canceled order_id=5 canceled_qty=5 cum_qty=0 reason=IMMEDIATE_OR_CANCEL was_resting=false price=100.01 side=SELL
# IOC partial: fill then cancel the remainder
NEW_ORDER instrument=AAA session=bob tif=IOC cl_ord_id=s3 side=SELL qty=5 price=100
expect count 3
expect accepted order_id=6
expect fill match_id=3 price=100 qty=2 buy.order_id=3 buy.leaves_qty=0 buy.cum_qty=5 sell.order_id=6 sell.leaves_qty=3 sell.cum_qty=2
expect canceled order_id=6 canceled_qty=3 cum_qty=2 reason=IMMEDIATE_OR_CANCEL leaves_qty=0
# sweep two levels, stop at the limit, rest the remainder at the limit price
NEW_ORDER instrument=AAA session=bob cl_ord_id=s4 side=SELL qty=2 price=100.1
NEW_ORDER instrument=AAA session=bob cl_ord_id=s5 side=SELL qty=2 price=100.2
NEW_ORDER instrument=AAA session=bob cl_ord_id=s6 side=SELL qty=2 price=100.5
NEW_ORDER instrument=AAA session=alice tif=GTC cl_ord_id=b3 side=BUY qty=5 price=100.2
expect count 4
expect accepted order_id=10 tif=GTC
expect fill match_id=4 price=100.1 qty=2 buy.leaves_qty=3 sell.order_id=7
expect fill match_id=5 price=100.2 qty=2 buy.leaves_qty=1 buy.cum_qty=4 sell.order_id=8
expect rested order_id=10 cl_ord_id=b3 price=100.2 leaves_qty=1
expect depth AAA bid 100.2:1:1
expect depth AAA ask 100.5:2:1
expect order session=alice cl_ord_id=b3 qty=5 cum_qty=4 leaves_qty=1 tif=GTC
# token b1 completed, so it may be reused (unique among live orders only)
NEW_ORDER instrument=AAA session=alice cl_ord_id=b1 side=BUY qty=1 price=99
expect count 2
expect accepted order_id=11 cl_ord_id=b1
expect rested order_id=11
# tokens are per session, not per instrument: b1 live on AAA blocks it on BBB
NEW_ORDER instrument=BBB session=alice cl_ord_id=b1 side=BUY qty=1 price=99
expect count 1
expect rejected instrument=BBB reason=DUPLICATE_CLORDID cl_ord_id=b1
# IOC fully filled: no Canceled event
NEW_ORDER instrument=AAA session=bob tif=IOC cl_ord_id=s7 side=SELL qty=1 price=99
expect count 2
expect accepted order_id=12
expect fill match_id=6 price=100.2 qty=1 buy.order_id=10 buy.leaves_qty=0 buy.cum_qty=5
expect depth AAA bid 99:1:1
