# SPEC 4.5/4.6: a market order crosses every level, including both band edges;
# its TIF (GTC here) is ignored and the remainder is canceled, never rested.
instrument AAA tick=0.01 lot=1 max_qty=100 min=99 max=101 ref=100 phase=CONTINUOUS
session alice firmA
session bob firmB
NEW_ORDER instrument=AAA session=bob cl_ord_id=lo side=SELL qty=5 price=99
NEW_ORDER instrument=AAA session=bob cl_ord_id=hi side=SELL qty=5 price=101
NEW_ORDER instrument=AAA session=alice type=MARKET tif=GTC cl_ord_id=m side=BUY qty=20 price=0
expect count 4
expect accepted order_id=3 ord_type=MARKET tif=GTC price=0 qty=20
expect fill match_id=1 price=99 qty=5 aggressor=BUY buy.order_id=3 buy.leaves_qty=15 buy.cum_qty=5 sell.order_id=1
expect fill match_id=2 price=101 qty=5 buy.leaves_qty=10 buy.cum_qty=10 sell.order_id=2
expect canceled order_id=3 cl_ord_id=m price=0 canceled_qty=10 cum_qty=10 reason=IMMEDIATE_OR_CANCEL was_resting=false leaves_qty=0
expect depth AAA bid
expect depth AAA ask
NEW_ORDER instrument=AAA session=alice type=MARKET cl_ord_id=m2 side=SELL qty=5 price=123
expect count 2
expect accepted order_id=4 price=123
expect canceled order_id=4 side=SELL price=123 canceled_qty=5 cum_qty=0 reason=IMMEDIATE_OR_CANCEL
