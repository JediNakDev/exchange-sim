# SPEC 4.5: STP with several resting orders at one level, partial fills before
# STP, aggressor-only mode/owner (resting mode irrelevant, owner 0 never self-trades).
config max_orders=128 max_instruments=5
instrument AAA tick=0.01 lot=1 max_qty=100 min=99 max=101 ref=100 phase=CONTINUOUS
instrument BBB tick=0.01 lot=1 max_qty=100 min=99 max=101 ref=100 phase=CONTINUOUS
instrument CCC tick=0.01 lot=1 max_qty=100 min=99 max=101 ref=100 phase=CONTINUOUS
instrument DDD tick=0.01 lot=1 max_qty=100 min=99 max=101 ref=100 phase=CONTINUOUS
session alice firmA
session bob firmB
# AAA: own, foreign, own at one level; CancelResting cancels both own, fills foreign, rests rest
NEW_ORDER instrument=AAA session=alice owner=firmA cl_ord_id=own1 side=SELL qty=5 price=100
NEW_ORDER instrument=AAA session=bob owner=firmB cl_ord_id=oth1 side=SELL qty=5 price=100
NEW_ORDER instrument=AAA session=alice owner=firmA cl_ord_id=own2 side=SELL qty=5 price=100
NEW_ORDER instrument=AAA session=alice owner=firmA stp=CANCEL_RESTING cl_ord_id=agg1 side=BUY qty=20 price=100 ts=7
expect count 5
expect accepted order_id=4 owner=firmA stp=CANCEL_RESTING qty=20
expect canceled instrument=AAA ts=7 order_id=1 cl_ord_id=own1 request_cl_ord_id=0 session=alice side=SELL price=100 canceled_qty=5 cum_qty=0 reason=SELF_TRADE_PREVENTION was_resting=true leaves_qty=0
expect fill match_id=1 price=100 qty=5 aggressor=BUY buy.order_id=4 buy.cl_ord_id=agg1 buy.session=alice buy.owner=firmA buy.leaves_qty=15 buy.cum_qty=5 sell.order_id=2 sell.cl_ord_id=oth1 sell.session=bob sell.owner=firmB sell.leaves_qty=0 sell.cum_qty=5
expect canceled order_id=3 cl_ord_id=own2 canceled_qty=5 reason=SELF_TRADE_PREVENTION was_resting=true
expect rested order_id=4 cl_ord_id=agg1 side=BUY price=100 leaves_qty=15
expect depth AAA bid 100:15:1
expect depth AAA ask
# BBB: CancelAggressor after a partial fill cancels only the remainder; own resting order stays
NEW_ORDER instrument=BBB session=bob owner=firmB cl_ord_id=oth2 side=SELL qty=5 price=100
NEW_ORDER instrument=BBB session=alice owner=firmA cl_ord_id=own3 side=SELL qty=5 price=100
NEW_ORDER instrument=BBB session=alice owner=firmA stp=CANCEL_AGGRESSOR cl_ord_id=agg2 side=BUY qty=10 price=100
expect count 3
expect accepted order_id=7
expect fill match_id=2 qty=5 buy.order_id=7 buy.leaves_qty=5 buy.cum_qty=5 sell.order_id=5 sell.leaves_qty=0
expect canceled order_id=7 cl_ord_id=agg2 request_cl_ord_id=0 side=BUY price=100 canceled_qty=5 cum_qty=5 reason=SELF_TRADE_PREVENTION was_resting=false leaves_qty=0
expect depth BBB ask 100:5:1
expect depth BBB bid
# CCC: CancelBoth at the best level cancels resting then aggressor; worse foreign level untouched
NEW_ORDER instrument=CCC session=alice owner=firmA cl_ord_id=own4 side=SELL qty=5 price=100
NEW_ORDER instrument=CCC session=bob owner=firmB cl_ord_id=oth3 side=SELL qty=5 price=100.5
NEW_ORDER instrument=CCC session=alice owner=firmA stp=CANCEL_BOTH cl_ord_id=agg3 side=BUY qty=10 price=101
expect count 3
expect accepted order_id=10
expect canceled order_id=8 canceled_qty=5 reason=SELF_TRADE_PREVENTION was_resting=true
expect canceled order_id=10 canceled_qty=10 cum_qty=0 reason=SELF_TRADE_PREVENTION was_resting=false
expect depth CCC ask 100.5:5:1
# DDD: aggressor owner 0 with a mode never self-matches
NEW_ORDER instrument=DDD session=alice cl_ord_id=z1 side=SELL qty=5 price=100
NEW_ORDER instrument=DDD session=alice stp=CANCEL_BOTH cl_ord_id=z2 side=BUY qty=5 price=100
expect count 2
expect accepted order_id=12 owner=0
expect fill match_id=3 qty=5 buy.order_id=12 sell.order_id=11
# DDD: resting mode is irrelevant; aggressor stp NONE with the same owner trades
NEW_ORDER instrument=DDD session=alice owner=firmA stp=CANCEL_BOTH cl_ord_id=z3 side=SELL qty=5 price=100
NEW_ORDER instrument=DDD session=alice owner=firmA cl_ord_id=z4 side=BUY qty=5 price=100
expect count 2
expect accepted order_id=14
expect fill match_id=4 qty=5 buy.order_id=14 buy.owner=firmA sell.order_id=13 sell.owner=firmA
